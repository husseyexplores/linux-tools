# qcalc config. Values below are the defaults.
# Look/behavior/shortcut changes: press Ctrl+Shift+R in qcalc (or run `qcalc reload`).
# Math changes (fractions, angle, timeout_ms): run `qcalc quit`, then press the hotkey.

# ---- Look
# Font name + size in points, e.g. "JetBrains Mono 13"
font = Sans 10
# Window width at 96 dpi (scaled with Xft.dpi)
width = 560

# ---- Layout (px at 96 dpi, scaled with Xft.dpi)
# input box corner radius (also the tab buttons)
radius = 0
# window corner radius, 0 = square (the tab uses 75% of it)
window_radius = 0
# space between the window edge and the input boxes
window_padding = 6
# space between input boxes
row_gap = 6
# space inside an input box, left/right and top/bottom
box_padding_x = 12
box_padding_y = 9
# input box border width (0 = none)
border_width = 1
# window border width (0 = none)
window_border = 1
# exchange-rate footer: offset from the input box edge, and space above it
footer_margin_left = 2
footer_margin_top = 5

# ---- Colors (#rrggbb)
# window background
color_bg = #1b1d23
# input box background
color_field = #262931
# box borders, button hover
color_border = #3a3f4b
# typed text
color_text = #e8e8ea
# result and placeholder
color_result = #8b919c
# cursor, focused outline, "copied" flash
color_accent = #4e5c72
# selected text highlight
color_selection = #2f4f7f
# close button hover
color_error = #e0707a

# ---- Behavior
# true: hide when another window gets focus
hide_on_focus_loss = false
# small x (hide) in a tab above the top-right corner
close_button = true
# button left of the x that re-centers the window (both off = no tab)
center_button = true
# right-click menu on the background (close, center, reload, clear history, quit)
context_menu = true
# Enter copies the result to the clipboard
copy_on_enter = true
# history entries kept
max_history = 1000

# ---- Math
# true: also show exact fractions, e.g. "1/3 ≈ 0.333"
fractions = false
# rad, deg or gra (empty = qalculate's own setting)
angle =
# relative | hybrid | absolute: how °C/°F mix in sums
# (relative: (100 °F to °C) + 5 °C = 42.78 °C; plain conversions are the same in all modes)
temperature = relative
# give up on a calculation after this many milliseconds
timeout_ms = 2000

# ---- Exchange rates (applies on reload)
# days; when a calculation uses a currency and the cached rates are older,
# fetch new ones in the background (0 = only via the menu / `qcalc update-rates`)
exchange_rates_max_age = 1

# ---- Shortcuts
# Comma-separated combos. Modifiers: ctrl, shift, alt, super.
# Keys use X11 names: a-z, 0-9, Return, Escape, Tab, Up, Down, F1-F12, Insert, Delete, space...
# Setting one replaces that action's defaults; "none" disables it.
# Cursor keys, Home/End, Backspace/Delete (and their ctrl/shift variants) are fixed.
key_hide = Escape
key_commit = Return, KP_Enter
key_new_row = ctrl+n, ctrl+Return, ctrl+KP_Enter
key_remove_row = ctrl+w
key_next_row = Tab, ctrl+Down, alt+Down
key_prev_row = shift+Tab, ctrl+Up, alt+Up
key_history_prev = Up
key_history_next = Down
key_copy = ctrl+c, ctrl+Insert
key_cut = ctrl+x, shift+Delete
key_paste = ctrl+v, shift+Insert
key_undo = ctrl+z
key_redo = ctrl+shift+z, ctrl+y
key_select_all = ctrl+a
key_delete_to_start = ctrl+u
key_delete_to_end = ctrl+k
key_reload = ctrl+shift+r
key_center = ctrl+shift+0
# unbound by default
key_clear_history =
key_quit =
key_update_rates =
